{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://makinuki.github.io/schemas/details.schema.json",
  "title": "MakiNuki MangaDetails",
  "description": "get_details() output validates against this schema; chapters items are ChapterItem (see chapter.schema.json).",
  "type": "object",
  "required": ["id", "title", "status", "chapters"],
  "if": { "required": ["covers"] },
  "then": { "required": ["coverUrl"] },
  "properties": {
    "id": {
      "type": "string",
      "description": "Must equal the manga id passed to get_details()"
    },
    "title": {
      "type": "string"
    },
    "altTitles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artists": {
      "type": "array",
      "items": { "type": "string" }
    },
    "genres": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["Ongoing", "Completed", "Hiatus", "Cancelled", "Unknown"]
    },
    "coverUrl": {
      "type": "string",
      "format": "uri",
      "description": "Absent when the title has no usable artwork; hosts treat absence as no cover available"
    },
    "chapters": {
      "type": "array",
      "items": { "$ref": "chapter.schema.json" }
    },
    "covers": {
      "type": "array",
      "description": "Additional renditions of the cover artwork; entries are distinct URLs and never duplicate coverUrl. Selection rules per SPEC Section 3.3.",
      "items": { "$ref": "manga.schema.json#/$defs/CoverVariant" }
    }
  },
  "additionalProperties": false
}